# Aether Server — Environment Variables
#
# Copy to .env and fill in values. .env is gitignored.
# Sensitive values MUST come from env vars, NOT config.yaml.
#
# Loading priority: flag > env var > config.yaml > default

# === Required (sensitive) ===
# Database password (config.yaml has everything except this).
AETHER_DATA_DATABASE_PASSWORD=aether_dev_2026

# === Optional overrides ===
# Override any config.yaml field via env var (AETHER_ prefix + path):
# AETHER_SERVICE_ENV=prod
# AETHER_SERVER_ADDR=:9090
# AETHER_DATA_DATABASE_HOST=localhost
# AETHER_DATA_DATABASE_PORT=5432
# AETHER_OTEL_ENDPOINT=localhost:4318
# AETHER_CONNECT_ENABLED=false

# === Test infrastructure (testcontainers, NOT application config) ===
# Docker daemon address (for testcontainers to start PG containers).
# Local Docker: leave unset. Remote Docker: set to TCP endpoint.
DOCKER_HOST=tcp://192.168.31.33:23750

# Disable ryuk container reaper (if remote Docker can't pull ryuk image).
TESTCONTAINERS_RYUK_DISABLED=true

# Override testcontainers PG image/credentials (defaults shown):
# AETHER_TEST_PG_IMAGE=postgres:16-alpine
# AETHER_TEST_PG_USER=postgres
# AETHER_TEST_PG_PASSWORD=password
# AETHER_TEST_PG_DATABASE=postgres
