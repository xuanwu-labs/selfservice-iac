{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.platform/contracts/schemas/request-create.schema.json",
  "title": "RequestCreate",
  "description": "User request to create an IaC change (specs/19)",
  "type": "object",
  "required": ["catalog_item_id", "env_id", "team_id", "form_values", "source"],
  "properties": {
    "catalog_item_id": {
      "type": "string",
      "pattern": "^cat_[a-z0-9]+$"
    },
    "env_id": { "type": "string" },
    "team_id": {
      "type": "string",
      "pattern": "^team_[a-z0-9]+$"
    },
    "tenant_id": { "type": "string" },
    "bundle_id": { "type": "string" },
    "form_values": {
      "type": "object",
      "additionalProperties": true,
      "description": "Validated against catalog item form_schema (D40)"
    },
    "source": {
      "type": "string",
      "enum": ["web", "cli", "cicd", "ai", "gateway"]
    },
    "source_context": {
      "type": "object",
      "additionalProperties": true,
      "description": "CI/CD pipeline info, AI session, etc."
    }
  },
  "additionalProperties": false
}
