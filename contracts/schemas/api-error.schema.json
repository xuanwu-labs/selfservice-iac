{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.platform/contracts/schemas/api-error.schema.json",
  "title": "ApiError",
  "description": "Unified error response (specs/19)",
  "type": "object",
  "required": ["error", "correlation_id"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable error code (see error-codes.yaml)",
          "examples": ["REQUEST_NOT_FOUND", "SCHEMA_INVALID"]
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message"
        },
        "details": {
          "type": "object",
          "additionalProperties": true,
          "description": "Additional error context"
        },
        "remediation": {
          "type": "string",
          "description": "Suggested fix for the user"
        },
        "retryable": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false
}
