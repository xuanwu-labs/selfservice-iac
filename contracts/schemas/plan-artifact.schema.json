{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.platform/contracts/schemas/plan-artifact.schema.json",
  "title": "PlanArtifact",
  "description": "Terraform plan artifact for plan/apply decoupling (D21)",
  "type": "object",
  "required": ["id", "request_id", "status", "plan_hash", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^art_[a-z0-9]+$" },
    "request_id": { "type": "string", "pattern": "^req_[a-z0-9]+$" },
    "status": { "type": "string", "enum": ["ready", "expired", "consumed"] },
    "plan_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "summary": {
      "type": "object",
      "properties": {
        "resources_to_add": { "type": "integer", "minimum": 0 },
        "resources_to_change": { "type": "integer", "minimum": 0 },
        "resources_to_destroy": { "type": "integer", "minimum": 0 }
      }
    },
    "cost_estimate_cents": { "type": "integer", "minimum": 0 },
    "storage_uri": { "type": "string", "description": "Object storage URI (not temp URL, 00a §5)" },
    "expires_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
