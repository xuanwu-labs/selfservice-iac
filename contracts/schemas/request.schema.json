{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.platform/contracts/schemas/request.schema.json",
  "title": "Request",
  "description": "IaC change request main entity (D21 state machine)",
  "type": "object",
  "required": ["id", "status", "catalog_item_id", "env_id", "team_id", "source", "created_at", "updated_at", "version"],
  "properties": {
    "id": { "type": "string", "pattern": "^req_[a-z0-9]+$" },
    "status": {
      "type": "string",
      "enum": ["submitted", "generating", "pending-admission", "planning", "plan-ready",
               "pending-approval", "applying", "reconciling", "succeeded",
               "rejected", "cancelled", "expired", "failed-retryable", "failed-terminal",
               "waiting-manual", "reconcile-pending"]
    },
    "catalog_item_id": { "type": "string", "pattern": "^cat_[a-z0-9]+$" },
    "env_id": { "type": "string" },
    "team_id": { "type": "string", "pattern": "^team_[a-z0-9]+$" },
    "tenant_id": { "type": "string" },
    "bundle_id": { "type": "string" },
    "form_values": { "type": "object", "additionalProperties": true },
    "form_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source": { "type": "string", "enum": ["web", "cli", "cicd", "ai", "gateway"] },
    "pinned_commit": { "type": "string", "description": "sha256:<hex>" },
    "resolved_params": { "type": "object", "description": "D28 provenance" },
    "plan_artifact_id": { "type": "string", "pattern": "^art_[a-z0-9]+$" },
    "cost_estimate_cents": { "type": "integer", "minimum": 0 },
    "cost_currency": { "type": "string", "default": "USD" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 0 },
    "correlation_id": { "type": "string", "format": "uuid" }
  }
}
