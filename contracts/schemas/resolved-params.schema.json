{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.platform/contracts/schemas/resolved-params.schema.json",
  "title": "ResolvedParams",
  "description": "Parameter resolution result with provenance (D28 9-stage pipeline)",
  "type": "object",
  "required": ["params", "provenance"],
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": true,
      "description": "Final resolved parameter values"
    },
    "provenance": {
      "type": "array",
      "description": "Per-parameter provenance chain (which stage set it)",
      "items": {
        "type": "object",
        "required": ["key", "stage", "source"],
        "properties": {
          "key": { "type": "string", "description": "Parameter name" },
          "stage": {
            "type": "string",
            "enum": ["S1-contract", "S2-defaults", "S3-governance", "S4-user",
                     "S5-dependency", "S6-override", "S7-validation", "S8-tag-merge", "S9-finalize"],
            "description": "Resolution stage (D28)"
          },
          "source": {
            "type": "string",
            "enum": ["contract", "catalog-default", "policy", "user-form",
                     "dependency-seed", "platform-mandated", "computed"],
            "description": "Where the value came from"
          },
          "layers_applied": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Tag merge layers applied (D18 7-layer model)"
          },
          "user_override_blocked": { "type": "boolean", "description": "True if user tried but was blocked by L1" }
        }
      }
    }
  }
}
