{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.platform/contracts/schemas/request-event.schema.json",
  "title": "RequestEvent",
  "description": "Request lifecycle event (audit trail)",
  "type": "object",
  "required": ["id", "request_id", "event_type", "actor", "occurred_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^evt_[a-z0-9]+$" },
    "request_id": { "type": "string", "pattern": "^req_[a-z0-9]+$" },
    "event_type": { "type": "string", "examples": ["request.created", "plan.ready", "approval.decided"] },
    "actor": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["human", "ai", "system"] },
        "user_id": { "type": "string" },
        "team_id": { "type": "string" }
      }
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "format": "uuid" }
  }
}
